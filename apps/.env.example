# Plantilla de variables de ec2-apps.
# Copia este archivo como apps/.env, reemplaza los valores y protégelo: chmod 600 .env
# El .env real NO se sube a git. Usa solo letras y números en las contraseñas
# ($ y # tienen significado especial en los archivos .env).

# --- Microsoft Entra ID (Azure) ---
# Directorio (tenant) que emite los JWT. Lo validan todos los servicios Java.
AZURE_TENANT_ID=ffcb40ec-aa43-4c4e-acd8-4d27467872c5
# Referencia (docker compose no las usa; las lee el portal Angular en su configuración):
#   AZURE_CLIENT_ID=2fc5d9c1-8b42-4674-b0dc-23990c22f370

# --- Base de datos (Oracle) ---
ORACLE_PASSWORD=CambiaEsto
DB_USER=barriodigital
DB_PASSWORD=CambiaEsto

# --- RabbitMQ (ec2-mq) ---
# IP PRIVADA de ec2-mq (estable entre reinicios del lab).
RABBITMQ_HOST=172.31.16.143
RABBITMQ_PORT=5672
# Deben coincidir con RABBITMQ_DEFAULT_USER y RABBITMQ_DEFAULT_PASS de mq/.env
RABBITMQ_USER=barrio
RABBITMQ_PASSWORD=cambiar-por-la-clave-de-ec2-mq

# --- Correo de notify ---
# false: solo simula el envío en el log. true: envía de verdad por SMTP.
MAIL_ENABLED=false
# Obligatorias solo si MAIL_ENABLED=true. La clave es una "clave de aplicación" de la cuenta, no la normal.
MAIL_USERNAME=
MAIL_PASSWORD=
# Opcionales (por defecto: MAIL_FROM = MAIL_USERNAME, smtp.gmail.com y 587)
# MAIL_FROM=
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
