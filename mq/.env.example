# Copia este archivo como mq/.env y cambia los valores. NO subas mq/.env al repositorio.
#
# Usuario y clave de la aplicación: se crean solo en el PRIMER arranque (volumen vacío).
# Si los cambias después, hay que borrar los volúmenes: docker compose down -v
RABBITMQ_DEFAULT_USER=barrio
RABBITMQ_DEFAULT_PASS=cambia-esta-clave

# Cookie de Erlang: debe ser la MISMA en ambos nodos. Usa una cadena larga y aleatoria.
RABBITMQ_ERLANG_COOKIE=cambia-esta-cookie-por-una-cadena-larga-y-aleatoria
